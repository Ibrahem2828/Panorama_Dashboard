{
  "name": "panorama-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next-cache.mjs && next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "contracts:diff": "node scripts/contract-diff.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "security:check": "node scripts/security-check.mjs",
    "validate": "npm run contracts:check && npm run i18n:check && npm run security:check && npm run routes:check && npm run type-check && npm run lint && npm run build",
    "routes:check": "node scripts/check-routes.mjs",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:contract": "npm run contracts:check",
    "test:e2e": "playwright test --grep @e2e",
    "test:a11y": "playwright test --grep @a11y",
    "test:security": "vitest run tests/security && npm run security:check",
    "test:performance": "vitest run tests/performance --passWithNoTests",
    "test:all": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:contract && npm run test:security"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
